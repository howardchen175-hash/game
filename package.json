{
  "name": "cosmic-colony",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch apps/web/server/index.ts",
    "build": "npm run data:check && tsc --noEmit && vite build",
    "start": "tsx apps/web/server/index.ts",
    "db:start": "bash scripts/db-start.sh",
    "db:migrate": "tsx packages/db/migrate.ts",
    "data:export": "python3 scripts/export-data.py",
    "data:check": "python3 scripts/export-data.py --check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build",
    "setup": "npm run db:start && npm run db:migrate"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
